# Optional Docker Compose overrides.
# The default command works without this file:
#   docker compose up --build
#
# To customize values:
#   Copy-Item .env.docker.sample .env.docker
#   docker compose --env-file .env.docker up --build

FRONTEND_PORT=5173
BACKEND_PORT=8000
RASA_PORT=5005
RASA_ACTION_PORT=5055
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rasa_ec_bot

FRONTEND_BASE_URL=http://localhost:5173
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
BACKEND_CORS_ALLOW_ORIGIN_REGEX=

RASA_INTERNAL_TOKEN=change-me-in-production
RASA_REQUEST_TIMEOUT_SEC=30
ACTION_HTTP_TIMEOUT_SEC=20

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_PATH=/api/chat
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_TIMEOUT_SEC=45
OLLAMA_EMBED_MODEL=mxbai-embed-large
OLLAMA_VLM_MODEL=qwen3-vl:2b

AGENT_LLM_PROVIDER=ollama
AGENT_LLM_BASE_URL=http://host.docker.internal:11434
AGENT_LLM_MODEL=qwen3.5:2b
AGENT_LLM_API_KEY=EMPTY
AGENT_LLM_TIMEOUT_SEC=45
AGENT_LLM_FALLBACK_PROVIDER=
AGENT_LLM_FALLBACK_BASE_URL=
AGENT_LLM_FALLBACK_MODEL=
AGENT_LLM_FALLBACK_API_KEY=
AGENT_LLM_FALLBACK_TIMEOUT_SEC=45

CHAT_ROUTER_ENABLE_AGENT=true
CHAT_ROUTER_RASA_CONFIDENCE_THRESHOLD=0.72
CHAT_ROUTER_LLM_REVIEW_ENABLED=true
CHAT_ROUTER_LLM_REVIEW_THRESHOLD=0.90

REDIS_CACHE_TTL_SEC=180
CHAT_ACTION_TTL_SEC=300

KB_EMBEDDING_DIM=1024
KB_RETRIEVAL_TOP_K=4
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=80

CHAT_UPLOAD_DIR=data/chat_uploads
CHAT_UPLOAD_MAX_MB=8

AMAP_WEB_KEY=
AMAP_WEB_SIG=
AMAP_TIMEOUT_MS=3000
AMAP_QPS_LIMIT=5
VITE_ENABLE_LOGISTICS_MAP=false
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_JS_CODE=
