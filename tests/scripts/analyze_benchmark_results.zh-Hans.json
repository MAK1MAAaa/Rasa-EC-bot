    "conclusion_lora_2": "\u4e24\u8005\u7684\u80fd\u529b\u8986\u76d6\u7387\u90fd\u8fbe\u5230 `1.0`\uff0c\u4f46 LoRA \u7248\u672c\u628a\u5e73\u5747\u53ef\u7528\u573a\u666f P95 \u65f6\u5ef6\u4ece `{0}` \u6beb\u79d2\u964d\u5230\u4e86 `{1}` \u6beb\u79d2\uff0c\u540c\u65f6\u5728\u77e5\u8bc6\u4e0e\u591a\u6a21\u6001\u573a\u666f\u4e0a\u4e5f\u66f4\u7a33\u5b9a\u3002\u8fd9\u8bf4\u660e LoRA \u8def\u7ebf\u6bd4\u5355\u7eaf\u5806\u57fa\u7840\u6a21\u578b\u66f4\u6709\u6548\u3002",
    "conclusion_bottleneck_1": "\u5f53\u524d\u4e3b\u8981\u7684\u8d28\u91cf\u74f6\u9888\u96c6\u4e2d\u5728 `order_query`\uff08\u8ba2\u5355\u67e5\u8be2\uff09\u548c `transactional_action`\uff08\u4e8b\u52a1\u64cd\u4f5c\uff09\u3002",
    "conclusion_bottleneck_2": "\u8ba2\u5355\u67e5\u8be2\u4e3b\u8981\u53d7\u8ba2\u5355\u53f7\u4e0e\u767b\u5f55\u9274\u6743\u94fe\u8def\u5f71\u54cd\uff1b\u4e8b\u52a1\u64cd\u4f5c\u4e3b\u8981\u53d7\u5361\u7247\u3001\u52a8\u4f5c\u3001\u786e\u8ba4\u6309\u94ae\u7b49\u7ed3\u6784\u5316\u8f93\u51fa\u4e0d\u5b8c\u6574\u5f71\u54cd\u3002\u4e5f\u5c31\u662f\u8bf4\uff0c\u73b0\u5728\u7684\u95ee\u9898\u4e0d\u53ea\u662f\u201c\u4f1a\u4e0d\u4f1a\u7b54\u201d\uff0c\u800c\u662f\u201c\u7b54\u51fa\u6765\u7684\u7ed3\u6784\u80fd\u4e0d\u80fd\u76f4\u63a5\u7528\u201d\u3002",
    "conclusion_unsupported_1": "`{0}` \u8fd9\u51e0\u5957\u7cfb\u7edf\u7684\u4e0d\u652f\u6301\u7387\u660e\u663e\u504f\u9ad8\u3002",
    "conclusion_unsupported_2": "\u8fd9\u8bf4\u660e\u5b83\u4eec\u5f53\u524d\u7684\u4e3b\u8981\u77ed\u677f\u4e0d\u662f\u63a8\u7406\u901f\u5ea6\uff0c\u800c\u662f\u80fd\u529b\u8986\u76d6\u4e0d\u8db3\u3002\u5bf9\u4e8e\u8fd9\u7c7b\u7cfb\u7edf\uff0c\u541e\u5410\u7387\u548c\u65f6\u5ef6\u6570\u5b57\u90fd\u4e0d\u80fd\u76f4\u63a5\u4ee3\u8868\u771f\u5b9e\u53ef\u7528\u6027\uff0c\u56e0\u4e3a\u5f88\u591a\u4efb\u52a1\u6839\u672c\u65e0\u6cd5\u6267\u884c\u3002",
    "conclusion_llm_1": "\u4e24\u4e2a\u7eaf LLM \u57fa\u7ebf\u7cfb\u7edf\u90fd\u8fd8\u4e0d\u80fd\u627f\u62c5\u5b8c\u6574\u94fe\u8def benchmark\u3002",
    "conclusion_llm_2": "`llm_lora_ollama` \u5728\u63a8\u8350\u573a\u666f\u4e0a\u7684\u65f6\u5ef6\u786e\u5b9e\u5f88\u4f4e\uff0c\u4f46\u8d28\u91cf\u4ecd\u7136\u4e0d\u8fc7\u5173\uff1b`llm_base_ollama` \u5219\u540c\u65f6\u5b58\u5728\u8986\u76d6\u8303\u56f4\u7a84\u548c\u65f6\u5ef6\u9ad8\u7684\u95ee\u9898\uff0c\u56e0\u6b64\u6682\u65f6\u4e0d\u9002\u5408\u4f5c\u4e3a\u4e3b\u65b9\u6848\u3002",
