    "notes_heading": "\u4e03\u3001\u6307\u6807\u8bf4\u660e",
    "notes": [
      "\u541e\u5410\u7387\u53cd\u6620\u5355\u4f4d\u65f6\u95f4\u5185\u7cfb\u7edf\u5904\u7406\u8bf7\u6c42\u7684\u80fd\u529b\uff0c\u4f46\u5f53\u5927\u91cf\u4f1a\u8bdd\u5c5e\u4e8e\u201c\u4e0d\u652f\u6301\u573a\u666f\u201d\u65f6\uff0c\u8fd9\u4e2a\u503c\u4f1a\u88ab\u663e\u8457\u653e\u5927\uff0c\u56e0\u6b64\u4e0d\u9002\u5408\u4f5c\u4e3a\u4e3b\u8981\u7ed3\u8bba\u4f9d\u636e\u3002",
      "\u5e73\u5747\u53ef\u7528\u573a\u666f P95 \u65f6\u5ef6\u53ea\u7edf\u8ba1\u771f\u6b63\u53ef\u7528\u7684\u573a\u666f\uff0c\u610f\u601d\u662f\u53ea\u770b\u53ef\u7528\u8def\u5f84\u4e0a 95% \u8bf7\u6c42\u53ef\u4ee5\u5728\u591a\u957f\u65f6\u95f4\u5185\u5b8c\u6210\u54cd\u5e94\uff0c\u56e0\u6b64\u6bd4\u539f\u59cb\u5e73\u5747\u65f6\u5ef6\u66f4\u6709\u89e3\u91ca\u4ef7\u503c\u3002",
      "\u8d28\u91cf\u901a\u8fc7\u7387\u8868\u793a\u56de\u7b54\u662f\u5426\u6ee1\u8db3\u8be5\u573a\u666f\u9884\u8bbe\u7684\u5185\u5bb9\u4e0e\u7ed3\u6784\u8981\u6c42\u3002",
      "\u4f1a\u8bdd\u6210\u529f\u7387\u8868\u793a\u5bf9\u8bdd\u662f\u5426\u603b\u4f53\u5b8c\u6210\u4e86\u76ee\u6807\u6d41\u7a0b\u3002",
      "\u4e0d\u652f\u6301\u7387\u8868\u793a\u8be5\u7cfb\u7edf\u5728\u8be5\u7c7b\u4efb\u52a1\u4e0a\u76f4\u63a5\u65e0\u6cd5\u63d0\u4f9b\u80fd\u529b\u7684\u6bd4\u4f8b\u3002"
    ]
  }
}
